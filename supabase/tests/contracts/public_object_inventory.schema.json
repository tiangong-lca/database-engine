{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.dev/contracts/database.public-object-inventory-closure.v2.schema.json",
  "title": "Exact-head public object inventory and dependency closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "source", "counts", "partitionCounts", "finalPublicAllowlist",
    "objects", "dependencies", "migrationPlan", "contractDropPlan", "security",
    "consumerEvidence", "residue", "contractReady"
  ],
  "properties": {
    "schemaVersion": {"const": "database.public-object-inventory-closure.v2"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue", "databaseSchemaSha", "migrationHead", "migrationTreeSha256", "predecessorInventorySha256",
        "partitionSha256", "ledgerSha256"
      ],
      "properties": {
        "issue": {"const": "tiangong-lca/database-engine#405"},
        "databaseSchemaSha": {"pattern": "^[0-9a-f]{40}$"},
        "migrationHead": {"const": "20260804090000"},
        "migrationTreeSha256": {"const": "7dbd4ca3a2af2399566c834e80825b4b292627125ec3a9d42d25f9b3d258c4dc"},
        "predecessorInventorySha256": {"pattern": "^[0-9a-f]{64}$"},
        "partitionSha256": {"pattern": "^[0-9a-f]{64}$"},
        "ledgerSha256": {"pattern": "^[0-9a-f]{64}$"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "view", "function"],
      "properties": {
        "table": {"const": 49}, "view": {"const": 12}, "function": {"const": 336}
      }
    },
    "partitionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "predecessor", "issue357", "issue358", "omitted-explicit"],
      "properties": {
        "core": {"const": 9}, "predecessor": {"const": 37},
        "issue357": {"const": 117}, "issue358": {"const": 230},
        "omitted-explicit": {"const": 4}
      }
    },
    "finalPublicAllowlist": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "uniqueItems": true, "items": {"pattern": "^public\\.[a-z_]+$"}
    },
    "objects": {
      "type": "array", "minItems": 397, "maxItems": 397,
      "items": {
        "type": "object",
        "required": [
          "objectKey", "objectType", "targetSchema", "partition", "decision",
          "ownerRepo", "sourceOfTruth", "migrationBatch", "testGate",
          "intendedConsumers", "roleContract", "consumerClosure", "consumerEvidence",
          "transitiveConsumerEvidence", "blockers", "lifecycleState", "catalog",
          "dependencies", "dependents"
        ],
        "properties": {
          "objectKey": {"type": "string", "pattern": "^public\\."},
          "objectType": {"enum": ["table", "partitioned_table", "view", "materialized_view", "function", "procedure"]},
          "targetSchema": {"enum": ["public", "api", "private", "util", "archive", "retire"]},
          "partition": {"enum": ["core", "predecessor", "issue357", "issue358", "omitted-explicit"]},
          "consumerEvidence": {"type": "array"},
          "blockers": {"type": "array"},
          "lifecycleState": {
            "type": "object", "additionalProperties": false,
            "required": ["physicalMoved", "compatPresent", "adapterOnly", "retired"],
            "properties": {
              "physicalMoved": {"type": "boolean"}, "compatPresent": {"type": "boolean"},
              "adapterOnly": {"type": "boolean"}, "retired": {"const": false}
            }
          }
        }
      }
    },
    "dependencies": {"type": "array"},
    "migrationPlan": {"$ref": "#/$defs/dependencyPlan"},
    "contractDropPlan": {"$ref": "#/$defs/dependencyPlan"},
    "security": {
      "type": "object",
      "required": [
        "relationAcl", "routineAcl", "policies", "defaultPrivileges", "schemaAcl",
        "publications", "extensionOwnedPublicObjectsExcluded"
      ],
      "properties": {"extensionOwnedPublicObjectsExcluded": {"type": "array", "maxItems": 0}}
    },
    "consumerEvidence": {"type": "object", "required": ["repositories"]},
    "residue": {
      "type": "object",
      "required": [
        "missingFromLiveCatalog", "unmappedLiveObjects", "duplicatePartitionObjects",
        "partitionCountDrift", "objectsWithoutConsumerClosure", "dynamicSqlReviewRequired",
        "retirementBlocked", "contractAuthorizationMissing"
      ]
    },
    "contractReady": {"const": false}
  },
  "$defs": {
    "dependencyPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["expandDependencyGroups", "contractDependencyGroups"],
      "properties": {
        "expandDependencyGroups": {"type": "array"},
        "contractDependencyGroups": {"type": "array"}
      }
    }
  }
}
