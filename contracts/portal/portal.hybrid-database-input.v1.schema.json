{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portal.hybrid-database-input.v1.schema.json",
  "title": "TianGong Portal Database Hybrid search input v1",
  "description": "Exact PostgREST JSON argument object for api.portal_hybrid_search_v1. UTF-8 byte bounds and the normalized serialized-filter 4096-byte bound are additionally enforced by the database contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "p_kind",
    "p_query_terms",
    "p_query_embedding",
    "p_filters",
    "p_limit"
  ],
  "properties": {
    "p_kind": {
      "$ref": "./portal.common-types.v1.schema.json#/$defs/DatasetKind"
    },
    "p_query_terms": {
      "description": "One to twelve unique terms after trim/lowercase normalization. Each normalized term is also limited to 2048 UTF-8 bytes and may contain no C0/C1 control character.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      }
    },
    "p_query_embedding": {
      "description": "Canonical transport form of exactly 1024 finite JSON numbers for extensions.vector(1024).",
      "type": "string",
      "maxLength": 65536,
      "pattern": "^\\[-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?(?:,-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?){1023}\\]$"
    },
    "p_filters": {
      "$ref": "#/$defs/Filters"
    },
    "p_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "p_kind": {
            "const": "flow"
          }
        },
        "required": [
          "p_kind"
        ]
      },
      "then": {
        "properties": {
          "p_filters": {
            "not": {
              "type": "object",
              "properties": {
                "processSubtype": true
              },
              "required": [
                "processSubtype"
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "FilterText": {
      "description": "Trimmed/lowercase public-card filter. The database additionally enforces at most 1024 UTF-8 bytes after normalization.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "Filters": {
      "description": "Strict normalized public-card filters. Their canonical serialized UTF-8 representation is limited to 4096 bytes.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accessLevel": {
          "$ref": "./portal.common-types.v1.schema.json#/$defs/AccessLevel"
        },
        "geography": {
          "$ref": "#/$defs/FilterText"
        },
        "classification": {
          "$ref": "#/$defs/FilterText"
        },
        "referenceYearFrom": {
          "$ref": "./portal.common-types.v1.schema.json#/$defs/Year"
        },
        "referenceYearTo": {
          "$ref": "./portal.common-types.v1.schema.json#/$defs/Year"
        },
        "processSubtype": {
          "$ref": "#/$defs/FilterText"
        },
        "source": {
          "$ref": "#/$defs/FilterText"
        }
      }
    }
  }
}
