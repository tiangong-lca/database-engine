{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "portal.public-facets.v2.schema.json",
  "title": "TianGong Portal public facets v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "queryFingerprint",
    "groups"
  ],
  "properties": {
    "schemaVersion": {
      "const": "portal.public-facets.v2"
    },
    "kind": {
      "description": "The selected data-set kind, or all when the response contains the backend-computed object-type facet.",
      "type": "string",
      "enum": [
        "all",
        "process",
        "flow"
      ]
    },
    "queryFingerprint": {
      "description": "Lowercase hexadecimal SHA-256 over the UTF-8 canonical JSON object {kind,query,filters,sort}.",
      "$ref": "./portal.common-types.v1.schema.json#/$defs/Sha256"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/FacetGroup"
      }
    }
  },
  "$defs": {
    "FacetGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "values",
        "hasMore"
      ],
      "properties": {
        "id": {
          "$ref": "./portal.common-types.v1.schema.json#/$defs/NonEmptyString"
        },
        "label": {
          "$ref": "./portal.common-types.v1.schema.json#/$defs/LocalizedText"
        },
        "values": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/FacetValue"
          }
        },
        "hasMore": {
          "description": "True when more canonical values exist beyond the deterministic first 100.",
          "type": "boolean"
        }
      }
    },
    "FacetValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "label",
        "count"
      ],
      "properties": {
        "value": {
          "$ref": "./portal.common-types.v1.schema.json#/$defs/NonEmptyString",
          "type": "string",
          "maxLength": 128
        },
        "label": {
          "$ref": "./portal.common-types.v1.schema.json#/$defs/LocalizedText"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "description": "Public facets over matching state-100/200 dataset versions, including older public versions. Counts count versions, not distinct dataset IDs."
}
