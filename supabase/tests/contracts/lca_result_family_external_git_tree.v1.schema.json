{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.dev/contracts/lca-result-family-external-git-tree.v1.schema.json",
  "title": "LCA result-family external exact Git-tree evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "issue",
    "parentIssue",
    "pathRuleVersion",
    "targets",
    "databaseCurrentEvidence",
    "repositories",
    "nextEdgeMirror",
    "nextDatabaseSnapshot",
    "blockers",
    "staticEvidenceComplete",
    "ddlAuthorized"
  ],
  "properties": {
    "schemaVersion": {"const": "lca-result-family-external-git-tree.v1"},
    "issue": {"const": "tiangong-lca/database-engine#397"},
    "parentIssue": {"const": "tiangong-lca/database-engine#390"},
    "pathRuleVersion": {"const": "issue-390-external-path-rules.v1"},
    "targets": {"type": "object"},
    "databaseCurrentEvidence": {
      "type": "object",
      "required": [
        "commit",
        "migrationHead",
        "catalogSha256",
        "stableApiFacadeNames",
        "publicPhysicalTargetNames",
        "publicLegacyRoutineNames",
        "physicalTargetsRemainAtFrozenPublicBoundary"
      ]
    },
    "repositories": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "key",
          "repository",
          "commit",
          "tree",
          "treeEntryCount",
          "scannedRegularBlobCount",
          "treeLedgerSha256",
          "unsupportedEntries",
          "evidence",
          "dynamicSelectorCandidates",
          "aggregates",
          "recognizedRuntimeDirectLegacyOccurrenceCount",
          "unresolvedActiveRuntimeEvidenceCount",
          "blockers"
        ]
      }
    },
    "nextEdgeMirror": {"type": "object"},
    "nextDatabaseSnapshot": {"type": "object"},
    "blockers": {"type": "array", "minItems": 1},
    "staticEvidenceComplete": {"const": false},
    "ddlAuthorized": {"const": false}
  }
}
