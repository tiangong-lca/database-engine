{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.dev/contracts/database.lca-worker-runtime-consumer.v1.schema.json",
  "title": "Exact-commit Worker runtime database source consumer inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "source", "scope", "connectionFamilies", "accesses",
    "dynamicResolvers", "requiredCapabilities", "declaredOnlyIdentifiers", "nonSqlQualifiedIdentifiers",
    "completeness", "residue", "sourceArtifactComplete", "contractReady"
  ],
  "properties": {
    "schemaVersion": {"const": "database.lca-worker-runtime-consumer.v1"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["issue", "workerRepository", "workerCommit", "refKind", "pullRequest", "canonical", "canonicalBaseAtCapture", "sourceTreeSha256", "trackedRuntimeRustFileCount", "derivation"],
      "properties": {
        "issue": {"const": "tiangong-lca/database-engine#408"},
        "workerRepository": {"const": "linancn/tiangong-lca-worker"},
        "workerCommit": {"const": "7c0a95f8aa4b8952e002bff7b91847e31cf2487b"},
        "refKind": {"const": "pull-request-head"},
        "pullRequest": {"const": "https://github.com/linancn/tiangong-lca-worker/pull/208"},
        "canonical": {"const": false},
        "canonicalBaseAtCapture": {"const": "2ee74ffaf431c0d43b9613bcb6bfed76fa447b66"},
        "sourceTreeSha256": {"pattern": "^[0-9a-f]{64}$"},
        "trackedRuntimeRustFileCount": {"type": "integer", "minimum": 50},
        "derivation": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["included", "excluded", "excludedSurfaceClasses"],
      "properties": {
        "included": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excluded": {"type": "array", "minItems": 5, "items": {"type": "string"}},
        "excludedSurfaceClasses": {"type": "array", "contains": {"const": "test-only"}}
      }
    },
    "connectionFamilies": {
      "type": "array", "minItems": 15, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "entrypoints", "environment", "fallback", "applicationName", "roleStrategy", "readOnly"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "entrypoints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "environment": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "fallback": {"type": "string"}, "applicationName": {"type": "string"},
          "roleStrategy": {"type": "string"}, "readOnly": {"type": "boolean"}
        }
      }
    },
    "accesses": {
      "type": "array", "minItems": 70,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["identifier", "objectKind", "verbs", "connectionFamilies", "surfaceClass", "schemaQualified", "searchPathDependent", "construction", "required", "sources"],
        "properties": {
          "identifier": {"pattern": "^(public|private|util|pgmq)\\.[a-z_][a-z0-9_]*$"},
          "objectKind": {"enum": ["relation", "routine"]},
          "verbs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["SELECT", "INSERT", "UPDATE", "DELETE", "EXECUTE"]}},
          "connectionFamilies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "surfaceClass": {"const": "production-runtime"},
          "schemaQualified": {"type": "boolean"}, "searchPathDependent": {"type": "boolean"},
          "construction": {"type": "string"}, "required": {"const": true},
          "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}}
        }
      }
    },
    "dynamicResolvers": {
      "type": "array", "minItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source", "construction", "closedAllowlist", "inputOrigin", "resolved"],
        "properties": {
          "id": {"type": "string"}, "source": {"$ref": "#/$defs/sourceRef"},
          "construction": {"type": "string"},
          "closedAllowlist": {"type": "array", "uniqueItems": true, "items": {"pattern": "^(public|private|util|pgmq)\\."}},
          "inputOrigin": {"type": "string"}, "resolved": {"type": "boolean"}
        }
      }
    },
    "requiredCapabilities": {
      "type": "array", "minItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["identifier", "privilege", "expected", "directCall"],
        "properties": {
          "identifier": {"type": "string"}, "privilege": {"enum": ["EXECUTE", "ALL_TABLE"]},
          "expected": {"enum": ["granted", "denied"]}, "directCall": {"type": "boolean"}
        }
      }
    },
    "declaredOnlyIdentifiers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "nonSqlQualifiedIdentifiers": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["identifier", "classification", "detail", "source"],
        "properties": {
          "identifier": {"pattern": "^(public|private|util|pgmq)\\.[a-z_][a-z0-9_]*$"},
          "classification": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "source": {"$ref": "#/$defs/sourceRef"}
        }
      }
    },
    "completeness": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceDiscoveredIdentifiers", "manifestIdentifiers", "unclassifiedSourceIdentifiers", "manifestIdentifiersMissingFromSource", "qualifiedIdentifierClosed", "unqualifiedIdentifierClosed", "bidirectionalSourceClosed"],
      "properties": {
        "sourceDiscoveredIdentifiers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "manifestIdentifiers": {"type": "array", "minItems": 70, "uniqueItems": true, "items": {"type": "string"}},
        "unclassifiedSourceIdentifiers": {"type": "array", "maxItems": 0},
        "manifestIdentifiersMissingFromSource": {"type": "array", "maxItems": 0},
        "qualifiedIdentifierClosed": {"const": true},
        "unqualifiedIdentifierClosed": {"const": false},
        "bidirectionalSourceClosed": {"const": false}
      }
    },
    "residue": {
      "type": "array", "minItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "blocking", "detail"],
        "properties": {"code": {"type": "string"}, "blocking": {"const": true}, "detail": {"type": "string"}}
      }
    },
    "sourceArtifactComplete": {"const": false},
    "contractReady": {"const": false}
  },
  "$defs": {
    "sourceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "line", "blobSha", "lineSha256", "needle"],
      "properties": {
        "path": {"pattern": "^crates/solver-worker/src/.+\\.rs$"},
        "line": {"type": "integer", "minimum": 1},
        "blobSha": {"pattern": "^[0-9a-f]{40}$"},
        "lineSha256": {"pattern": "^[0-9a-f]{64}$"},
        "needle": {"type": "string", "minLength": 1}
      }
    }
  }
}
