{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.dev/contracts/database.public-object-inventory-closure.v1.schema.json",
  "title": "Public object inventory and dependency closure",
  "type": "object",
  "required": ["schemaVersion", "source", "counts", "objects", "dependencies", "migrationPlan", "security", "consumerEvidence", "residue", "contractReady"],
  "properties": {
    "schemaVersion": {"const": "database.public-object-inventory-closure.v1"},
    "source": {"type": "object", "required": ["baseline", "baselineMergeSha", "databaseBaseSha"]},
    "counts": {"type": "object", "required": ["table", "view", "function"]},
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["objectKey", "objectType", "targetSchema", "decision", "ownerRepo", "sourceOfTruth", "migrationBatch", "testGate", "intendedConsumers", "roleContract", "consumerClosure", "consumerEvidence", "transitiveConsumerEvidence", "blockers", "catalog", "dependencies", "dependents"],
        "properties": {
          "targetSchema": {"enum": ["public", "api", "private", "util", "archive", "retire"]},
          "consumerEvidence": {"type": "array"},
          "blockers": {"type": "array"}
        }
      }
    },
    "dependencies": {"type": "array"},
    "migrationPlan": {"type": "object", "required": ["expandDependencyGroups", "contractDependencyGroups"]},
    "security": {"type": "object", "required": ["relationAcl", "routineAcl", "policies", "defaultPrivileges", "schemaAcl", "publications"]},
    "consumerEvidence": {"type": "object", "required": ["repositories"]},
    "residue": {"type": "object", "required": ["missingFromLiveCatalog", "unmappedLiveObjects", "objectsWithoutConsumerClosure", "dynamicSqlReviewRequired", "retirementBlocked"]},
    "contractReady": {"type": "boolean"}
  }
}
